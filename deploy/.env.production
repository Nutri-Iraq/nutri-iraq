# .env.production  —  متغيرات البيئة للإنتاج
# انسخ هذا الملف واسمه .env ثم عدّل القيم

# ── App ────────────────────────────────────
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate

# ── Database ───────────────────────────────
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_2026

# ── Redis ──────────────────────────────────
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD_2026

# ── Frontend ───────────────────────────────
NEXT_PUBLIC_API_URL=https://api.nutri-iraq.iq/api

# ── WhatsApp Business API ──────────────────
WHATSAPP_TOKEN=your_whatsapp_business_token
WHATSAPP_PHONE_ID=your_phone_number_id

# ── Mail ───────────────────────────────────
MAIL_USERNAME=info@nutri-iraq.iq
MAIL_PASSWORD=your_email_app_password
