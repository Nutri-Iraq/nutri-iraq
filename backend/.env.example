APP_NAME="نيوتري عراق"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack

# قاعدة البيانات
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nutri_iraq
DB_USERNAME=postgres
DB_PASSWORD=your_password

# Cache & Queue
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=info@nutri-iraq.iq
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@nutri-iraq.iq
MAIL_FROM_NAME="نيوتري عراق"

# WhatsApp Business API
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_ID=your_phone_id
WHATSAPP_TOKEN=your_whatsapp_token

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost:3000,nutri-iraq.iq

# Storage
FILESYSTEM_DISK=local
